  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>netcoreapp2.1</TargetFramework>
  </PropertyGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="dotnet run --no-build $(SolutionDir)src\portable\ReactUi\react\build $(SolutionDir)src\portable\ReactShared\ReactShared.csproj&#xD;&#xA;copy $(SolutionDir)src\portable\ReactUi\data\*.xsd $(SolutionDir)src\portable\ReactShared\data&#xD;&#xA;copy $(SolutionDir)src\portable\ReactUi\data\*.xml $(SolutionDir)src\portable\ReactShared\data&#xD;&#xA;copy $(SolutionDir)src\portable\ReactUi\data\*.eaf $(SolutionDir)src\portable\ReactShared\data&#xD;&#xA;mkdir $(SolutionDir)src\portable\ReactShared\data\localization&#xD;&#xA;copy $(SolutionDir)src\portable\ReactUi\data\localization\*.json $(SolutionDir)src\portable\ReactShared\data\localization&#xD;&#xA;xcopy /s /y $(SolutionDir)src\portable\ReactUi\react\build $(SolutionDir)src\portable\ReactShared\react\build" />
  </Target>

</Project>
